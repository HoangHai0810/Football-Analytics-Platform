# .env.example – copy to .env and adjust values as needed

# ClickHouse connection
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_dev
CLICKHOUSE_DB=football_analytics
# true for ClickHouse Cloud / HTTPS ngrok tunnel (Render backend uses CLICKHOUSE_SSL)
CLICKHOUSE_SSL=false
CLICKHOUSE_SECURE=false

# PostgreSQL connection (used by Kestra, future BE services)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=football_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev

# Redis (cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev

# Kafka / Redpanda
KAFKA_BROKERS=localhost:9092

# MinIO / S3
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=football-lake
S3_REGION=us-east-1

# External APIs
FOOTBALL_DATA_API_KEY=YOUR_FOOTBALL_DATA_API_KEY_HERE  # register at football-data.org
# StatsBomb Open Data does not need an API key; leave blank if using free data
STATSBOMB_AUTH_KEY=

# OpenAI (for AI Analyst layer)
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
